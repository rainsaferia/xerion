# Copy to .env (never commit .env). Values here are local-dev placeholders only.

# docker-compose
POSTGRES_USER=pi_dev
POSTGRES_PASSWORD=pi_dev_password
POSTGRES_DB=project_intelligence
POSTGRES_PORT=5432
REDIS_PORT=6379

# Backend (prefix PI_)
PI_APP_ENV=local
PI_LOG_LEVEL=INFO
PI_DATABASE_URL=postgresql://pi_dev:pi_dev_password@localhost:5432/project_intelligence
PI_REDIS_URL=redis://localhost:6379/0
PI_CORS_ORIGINS=["http://localhost:3000"]

# Frontend (server-side only, not exposed to browser)
API_BASE_URL=http://localhost:8000

# Future (leave empty; real keys go in an untracked .env or secret manager only)
# PI_LLM_PROVIDER=
# PI_LLM_MODEL=
# PI_LLM_API_KEY=

